# =====================================================================
# ANNEX backend — environment template.
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is gitignored.
# Full guidance: docs/guides/installation.md
# =====================================================================

# Runtime environment: development | test | staging | production
APP_ENV=development

# Enable debug mode (docs UI, verbose logs). Never true in production.
DEBUG=false

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Allowed CORS origins (JSON list; pydantic-settings parses complex types as JSON).
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ---------------------------------------------------------------------
# Phase 4 (database) — direct PostgreSQL endpoint.
# Local Supabase stack default; use the pooled URL in production.
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ---------------------------------------------------------------------
# Phase 5 (authentication) — Firebase Admin SDK.
# Service-account JSON is a secret: keep it outside the repo (e.g. ../secrets/).
# FIREBASE_PROJECT_ID=<firebase project id>
# FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/annex-firebase-service-account.json

# ---------------------------------------------------------------------
# Added in later phases — see docs/guides/installation.md for guidance.
# Uncomment and fill as each phase lands:
# ---------------------------------------------------------------------
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
# FIREBASE_PROJECT_ID=<firebase project id>
# OPENAI_API_KEY=<openai key>
# GEMINI_API_KEY=<gemini key>
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
